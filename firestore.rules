rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection rules
    match /users/{userId} {
      // Allow users to read their own data
      allow read: if isOwner(userId);
      
      // Allow users to create their own document
      allow create: if isOwner(userId) 
                    && request.resource.data.phone_number is string
                    && request.resource.data.is_active == true
                    && request.resource.data.is_staff == false
                    && request.resource.data.is_superuser == false;
      
      // Allow users to update their own data
      // But prevent them from changing security flags
      allow update: if isOwner(userId)
                    && request.resource.data.is_active == resource.data.is_active
                    && request.resource.data.is_staff == resource.data.is_staff
                    && request.resource.data.is_superuser == resource.data.is_superuser;
      
      // Allow users to delete their own account
      allow delete: if isOwner(userId);
      
      // Allow listing/querying users collection for admin login verification
      // This allows checking phone_number and is_superuser before OTP
      allow list: if true;
      
      // Favourites subcollection - users can only access their own favourites
      match /favourites/{favouriteId} {
        allow read, write: if isOwner(userId);
      }

      // Addresses subcollection - users can only access their own addresses
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Admins collection rules - for admin email/password login
    match /admins/{adminId} {
      // Allow admin to read their own data
      allow read: if isOwner(adminId);
      
      // Allow authenticated users to create their own admin document
      // (Only when their Firebase Auth UID matches the document ID)
      allow create: if isOwner(adminId);
      
      // Allow admin to update their own data
      allow update: if isOwner(adminId);
      
      // Allow querying admins collection by email for login verification
      allow list: if isAuthenticated();
    }

    // Services collection rules
    match /services/{serviceId} {
      // Allow anyone (including guests) to read services
      allow read: if true;
    }

    // Categories collection rules
    match /categories/{categoryId} {
      // Allow anyone (including guests) to read categories
      allow read: if true;
    }

    // Orders collection rules
    match /orders/{orderId} {
      // Allow users to create orders
      allow create: if isAuthenticated();
      // Allow users to read their own orders
      allow read: if isAuthenticated() && (resource.data.user_id == request.auth.uid);
      // Allow users to update their own orders (e.g. cancel) - optional for now
    }

    // About Us collection rules
    match /about_us/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() 
                   && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_superuser == true;
    }

    // FAQs collection rules
    match /faqs/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() 
                   && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_superuser == true;
    }

    // Support collection rules
    match /support/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() 
                   && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_superuser == true;
    }

    // Support Tickets collection rules - allow users to create tickets
    match /support_tickets/{ticketId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource.data.user_id == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_superuser == true);
      allow update: if isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_superuser == true;
    }

    // Gallery Images collection rules
    match /gallery_images/{imageId} {
      // Allow anyone (including guests) to read gallery images
      allow read: if true;
      allow write: if isAuthenticated() 
                   && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_superuser == true;
    }
    
    // Helper function to check if user is an admin (from admins collection)
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.is_superuser == true;
    }
    
    // Helper function to check if user is a superuser (from users collection - legacy)
    function isSuperuser() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_superuser == true;
    }
    
    // Admin users can read/write all documents (check both admins and users collections)
    match /{document=**} {
      allow read, write: if isAdmin() || isSuperuser();
    }
  }
}
